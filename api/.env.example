# ===========================================================================
# ImageTeller API - environment configuration
#
# Copy this file to ".env" in the imageteller-api/ folder and fill in real
# values.
# ===========================================================================

# --- Storage ---------------------------------------------------------------
# Base directory for generated media. The API uses the subfolders images/
# (uploaded source images) and chapters/ (generated illustrations) beneath it.
DATA_PATH=/srv/imageteller/data

# --- Database (MySQL) ------------------------------------------------------
DB_HOST=localhost
DB_DATABASE=imageteller
DB_USER=imageteller
DB_PASSWORD=change-me

# --- Language models -------------------------------------------------------
# Provider for each role. Supported values: openai | ollama | vllm
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.8

# Model used for character/actor library extraction + illustration prompts.
LLM_CHARACTER_LIB_PROVIDER=openai
LLM_CHARACTER_LIB_MODEL=gpt-4o
LLM_CHARACTER_LIB_TEMPERATURE=0.5

# Model used to describe uploaded images (vision). For "openai" the image is
# sent by URL; for "ollama" it is sent to OLLAMA_SERVER_IMAGE as base64.
LLM_IMAGE_PROVIDER=openai
LLM_IMAGE_MODEL=gpt-4o
LLM_IMAGE_TEMPERATURE=0.5

# Endpoints for the self-hosted providers.
OLLAMA_SERVER=http://localhost:11434
# Separate Ollama endpoint used only for vision/image description.
OLLAMA_SERVER_IMAGE=http://localhost:11434
VLLM_SERVER=http://localhost:8000/v1

# OpenAI API key. Used when any provider above is set to "openai".
OPENAI_KEY=sk-your-openai-key

# --- Image generation (ComfyUI) -------------------------------------------
COMFYUI_SERVER=comfyui.your-domain.example
COMFYUI_USERNAME=comfyui
COMFYUI_PASSWORD=change-me

# --- NLP helper service ----------------------------------------------------
NLP_API_SERVER=http://localhost:5000

# --- Public media URLs -----------------------------------------------------
# Public base URLs the API returns for generated media (note trailing slash on
# IMAGE_URL; CHAPTER_URL is joined with "<story_id>/<chapter_id>").
IMAGE_URL=https://your-domain.example/imageteller-api/images/
CHAPTER_URL=https://your-domain.example/imageteller-api/chapters/

# --- API access ------------------------------------------------------------
# Shared secret guarding the API documentation endpoints (/docs, /redoc).
# Generate a strong random value:  openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Anonymous user id that is treated as the administrator (sees all stories).
ADMIN_USER=change-me-to-a-secret-admin-id

# Allowed browser origin for CORS: your front-end's scheme + host, no path.
DOMAIN_URL=https://your-domain.example

# --- Abuse control (all optional; sensible defaults if unset) --------------
# Max images accepted per /image-to-story/ request.
# MAX_UPLOAD_FILES=10
#
# Rate limits, expressed as "<count>/<period>" (period: second|minute|hour|day).
# Defaults shown. Limits are enforced PER uvicorn worker when using the default
# in-memory backend, so with --workers 4 the effective limit is 4x. Point
# RATE_LIMIT_STORAGE_URI at a shared backend (e.g. redis://host:6379) for exact,
# cross-worker enforcement.
# RATE_LIMIT_STORAGE_URI=memory://
# RATE_LIMIT_GENERATE=10/hour
# RATE_LIMIT_ILLUSTRATE=60/hour
# RATE_LIMIT_REGENERATE=30/hour
# RATE_LIMIT_READ=120/minute
# RATE_LIMIT_WRITE=60/minute
# RATE_LIMIT_MEDIA=300/minute
