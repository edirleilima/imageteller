# ===========================================================================
# ImageTeller web - build-time configuration (Vite)
#
# Copy this file to ".env" in the imageteller-web/ folder. Vite inlines VITE_*
# variables at build time, so rebuild after changing them.
# ===========================================================================

# Base URL of the ImageTeller API (no trailing slash). All API calls in
# src/api.js are made relative to this.
VITE_API_BASE_URL=https://your-domain.example/imageteller-api

# Placeholder image shown in a chapter slot while its illustration generates.
VITE_PLACEHOLDER_IMAGE_URL=/imageteller/images/placeholder.png
